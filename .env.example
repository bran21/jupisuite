# Solana Wallet (Base58 private key)
WALLET_PRIVATE_KEY=

# Jupiter Developer Platform API Key (from developers.jup.ag/portal)
JUPITER_API_KEY=

# Helius API Key (from helius.dev) — used for RPC + DAS + Webhooks
HELIUS_API_KEY=

# Birdeye API Key (from birdeye.so) — optional, for extra market data
BIRDEYE_API_KEY=

# Anthropic API Key (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# Solana RPC URL (defaults to Helius mainnet if HELIUS_API_KEY is set)
SOLANA_RPC_URL=
